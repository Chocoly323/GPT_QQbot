HOST=127.0.0.1
PORT=3789
ONEBOT_API_BASE=http://127.0.0.1:3000
# OneBot HTTP API bearer token, if configured in your bridge:
ONEBOT_ACCESS_TOKEN=
# Incoming event secret: NapCat HMAC-SHA1 signature or Bearer token:
EVENT_TOKEN=
# Your QQ number. Set this to reject events for other accounts:
QQ_ACCOUNT=
CODEX_CLI_PATH=codex
# Empty means use the model from your existing Codex configuration:
CODEX_MODEL=
# Empty inherits Codex defaults; priority enables Fast mode:
CODEX_REASONING_EFFORT=
CODEX_SERVICE_TIER=
HISTORY_TURNS=20
CODEX_TIMEOUT_MS=120000
QUEUE_LIMIT=30
DATA_DIR=./data
# Local traffic limits, not QQ official safe thresholds:
SEND_INTERVAL_MS=3000
CONTACT_WINDOW_MS=600000
CONTACT_MAX_REPLIES=10

# Enable native Codex tools and generated-file forwarding after sandbox verification.
NATIVE_FILES=0
NATIVE_TIMEOUT_MS=300000

# Enable together with the user systemd QQ schedule timer (Asia/Shanghai 01:00-07:00).
QQ_NIGHT_OFFLINE=0
